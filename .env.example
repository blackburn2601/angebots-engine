# ── Local development ─────────────────────────────────────────────────────────
# Run `docker compose up -d` first, then set DATABASE_URL as below.

DATABASE_URL="postgresql://angebots:secret@localhost:5432/angebots_engine"
NEXTAUTH_SECRET="change-me-min-32-chars-random-string"
NEXTAUTH_URL="http://localhost:3000"

# Seed (used by `npm run db:seed`)
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="Admin123!"
SEED_ADMIN_NAME="Super Admin"

# ── Docker / production (docker-compose) ──────────────────────────────────────
# Copy this file to .env and fill in real values for each customer instance.

# Port the app is exposed on — change per customer to avoid conflicts
APP_PORT=3000

POSTGRES_USER=angebots
POSTGRES_PASSWORD=change-me
POSTGRES_DB=angebots_engine

# Must be >= 32 random characters — generate with: openssl rand -base64 32
NEXTAUTH_SECRET=change-me-min-32-chars-random-string

# Public URL of this customer instance
NEXTAUTH_URL=https://customer.example.com

# CORS origin for /api/v1 — restrict to your frontend domain in production
ALLOWED_ORIGIN=*
