generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String    @id @default(cuid())
  name            String
  email           String    @unique
  password        String
  rolle           String
  aktiv           Boolean   @default(true)
  muss_pw_aendern Boolean   @default(false)
  erstellt_am     DateTime  @default(now())
  letzter_login   DateTime?
  accounts        Account[]
  sessions        Session[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model ApiKey {
  id              String      @id @default(cuid())
  label           String
  key_hash        String      @unique
  key_prefix      String
  erstellt_am     DateTime    @default(now())
  letzter_zugriff DateTime?
  aktiv           Boolean     @default(true)
  logs            ApiKeyLog[]
}

model ApiKeyLog {
  id          String   @id @default(cuid())
  apiKeyId    String
  apiKey      ApiKey   @relation(fields: [apiKeyId], references: [id])
  endpunkt    String
  ip          String
  zeitstempel DateTime @default(now())
}

model Domain {
  id          String            @id @default(cuid())
  name        String
  slug        String            @unique
  config_json String            @default("{\"felder\":[],\"parameter\":[],\"validierungen\":[],\"regelwerk\":[],\"komponenten\":[]}")
  erstellt_am DateTime          @default(now())
  updated_at  DateTime          @updatedAt
  pricelists  DomainPricelist[]
}

model Pricelist {
  id          String            @id @default(cuid())
  name        String
  gueltig_ab  DateTime?
  gueltig_bis DateTime?
  aktiv       Boolean           @default(true)
  items_json  String            @default("[]")
  erstellt_am DateTime          @default(now())
  updated_at  DateTime          @updatedAt
  domains     DomainPricelist[]
}

model DomainPricelist {
  domainId    String
  pricelistId String
  domain      Domain    @relation(fields: [domainId], references: [id], onDelete: Cascade)
  pricelist   Pricelist @relation(fields: [pricelistId], references: [id], onDelete: Cascade)

  @@id([domainId, pricelistId])
}

model LoginAttempt {
  id          String   @id @default(cuid())
  ip          String
  email       String
  success     Boolean
  zeitstempel DateTime @default(now())

  @@index([ip, zeitstempel])
}

model ApiLog {
  id              String   @id @default(cuid())
  method          String
  path            String
  status_code     Int?
  duration_ms     Int?
  request_headers String?
  request_body    String?
  response_body   String?
  ip              String?
  user_id         String?
  api_key_id      String?
  error           String?
  zeitstempel     DateTime @default(now())

  @@index([zeitstempel])
  @@index([path])
  @@index([status_code])
}

model WebhookUrl {
  id          String   @id @default(cuid())
  label       String
  url         String
  description String?
  aktiv       Boolean  @default(true)
  erstellt_am DateTime @default(now())
  updated_at  DateTime @updatedAt
}

model AppSetting {
  key        String   @id
  value      String
  updated_at DateTime @updatedAt
  updated_by String?
}
